#!/bin/sh
set -e

# pdn-linmail postinst.
#
# This package ships code only (the binary, the app manifest and the HTML
# templates) into /usr/share/packetnet/apps/linmail. Runtime state (linmail.cfg,
# the mail files, linmail-pdn.conf) lives in /var/lib/packetnet/apps/linmail and
# is never shipped or overwritten by the package.
#
# The packetnet node package owns the packetnet user and /var/lib/packetnet.
# It is only a Recommends, so prepare the state dir only when the user exists;
# pdn creates it at runtime otherwise. Does not restart packetnet.

case "$1" in
  configure)
    if getent passwd packetnet >/dev/null; then
      install -d -o packetnet -g packetnet -m 0750 /var/lib/packetnet/apps/linmail
    fi
    ;;
esac

exit 0
